{
  lang = "en"
  Texts = [
    {
      Id = "ModsNikkelMHadesBiomesSnakeDamageResistanceBonus"
      InheritFrom = "BaseBoonMultiline"
      DisplayName = "Ophis"
      Description = "Surfaces periodically to fire a burst of {$Keywords.SnakeFamiliarVenom} darts. Each hit adds {#BoldFormat}{$TooltipData.ExtractData.VenomDamagePerHit} {#Prev}damage to every {$Keywords.SnakeFamiliarVenom} tick and slows the foe for {#BoldFormat}{$TooltipData.ExtractData.VenomDuration} {#Prev}Sec."
    }
    {
      Id = "ModsNikkelMHadesBiomesSnakeDamageTakenStatLine"
      InheritFrom = "BaseStatLine"
      DisplayName = "{!Icons.Bullet}{#PropertyFormat}Damage Taken:"
      Description = "{#UpgradeFormat}-{$TooltipData.ExtractData.DamageResistance}%{#Prev}"
    }
    {
      Id = "ModsNikkelMHadesBiomesSnakeGoldEarnedStatLine"
      InheritFrom = "BaseStatLine"
      DisplayName = "{!Icons.Bullet}{#PropertyFormat}Bonus Gold earned:"
      Description = "{#UpgradeFormat}{$TooltipData.ExtractData.MoneyRewardIncrease:P}{#Prev}"
    }
    {
      Id = "ModsNikkelMHadesBiomesSnakeBloodBond"
      DisplayName = "Blood Bond"
      Description = "While together, you take {#UpgradeFormat}-{$TooltipData.ExtractData.DamageResistance}% {#Prev}damage."
    }
    {
      Id = "ModsNikkelMHadesBiomesSnakeBloodBond2"
