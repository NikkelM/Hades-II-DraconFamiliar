    }
    {
      Id = "ModsNikkelMHadesBiomesSnakeProsperousBond"
      DisplayName = "Prosperous Bond"
      Description = "While together, any {!Icons.Currency} you gain is worth {#AltUpgradeFormat}{$TooltipData.ExtractData.MoneyRewardIncrease:P}{#Prev}. When leaving a {$Keywords.RoomAlt}, automatically break all {$Keywords.ModsNikkelMHadesBiomesGoldenUrnIcon} and collect their contents."
