      InheritFrom = "ModsNikkelMHadesBiomesSnakeBloodBond"
      Description = "While together, you take {#OldFormat}-{$TooltipData.Old.ExtractData.DamageResistance}%{#Prev}{!Icons.RightArrow}{#UpgradeFormat}-{$TooltipData.New.ExtractData.DamageResistance}% {#Prev}damage."
    }
